        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-faq1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-faq sk-faq1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"range\" inline title=\"Questions\" name=\"questions\" min=\"1\" max=\"6\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title text-center mb-5 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Frequently asked questions</h2>\n                <div class=\"accordion\" id=\"sk-faq-acc\">\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-1\" aria-expanded=\"true\" aria-controls=\"sk-faq-1\">Where does the event take place?</button></h3>\n                        <div id=\"sk-faq-1\" class=\"accordion-collapse collapse show\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Write a clear answer here, in one or two short paragraphs.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 1\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-2\" aria-expanded=\"false\" aria-controls=\"sk-faq-2\">Can I get a refund?</button></h3>\n                        <div id=\"sk-faq-2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Write a clear answer here, in one or two short paragraphs.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 2\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-3\" aria-expanded=\"false\" aria-controls=\"sk-faq-3\">Is there an age limit?</button></h3>\n                        <div id=\"sk-faq-3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Write a clear answer here, in one or two short paragraphs.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 3\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-4\" aria-expanded=\"false\" aria-controls=\"sk-faq-4\">How do I contact the team?</button></h3>\n                        <div id=\"sk-faq-4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Write a clear answer here, in one or two short paragraphs.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 4\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-5\" aria-expanded=\"false\" aria-controls=\"sk-faq-5\">Question five?</button></h3>\n                        <div id=\"sk-faq-5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Write a clear answer here, in one or two short paragraphs.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 5\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-6\" aria-expanded=\"false\" aria-controls=\"sk-faq-6\">Question six?</button></h3>\n                        <div id=\"sk-faq-6\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Write a clear answer here, in one or two short paragraphs.</div></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-faq .accordion-item{border: 0; background: rgba(181, 204, 232, .17); border-radius: var(--sk-r-md) !important; margin-bottom: .75rem; overflow: hidden;}.sk-faq .accordion-button{background: transparent; font-weight: 700; color: var(--sk-navy); box-shadow: none;}.sk-faq .accordion-button:not(.collapsed){color: var(--sk-navy); background: rgba(181, 204, 232, .35);}</style>\n</section>",
          "_cid": "vyjBEgr75B",
