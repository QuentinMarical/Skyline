          "_name": "sk-gallery1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-gallery1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <select title=\"Photos\" name=\"photosAmount\">\n            <option value=\"3\">3</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Memories from last time</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">A look back at the previous edition.</h3>\n            </div>\n        </div>\n        <div class=\"row g-3\">\n            <div class=\"col-6 col-md-4\"><figure class=\"sk-photo mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Photo 1\"></figure></div>\n            <div class=\"col-6 col-md-4\"><figure class=\"sk-photo mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Photo 2\"></figure></div>\n            <div class=\"col-6 col-md-4\"><figure class=\"sk-photo mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Photo 3\"></figure></div>\n            <div class=\"col-6 col-md-4\" mbr-if=\"photosAmount == '6'\"><figure class=\"sk-photo mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Photo 4\"></figure></div>\n            <div class=\"col-6 col-md-4\" mbr-if=\"photosAmount == '6'\"><figure class=\"sk-photo mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Photo 5\"></figure></div>\n            <div class=\"col-6 col-md-4\" mbr-if=\"photosAmount == '6'\"><figure class=\"sk-photo mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Photo 6\"></figure></div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-photo img{width: 100%; height: 100%; object-fit: cover; display: block;}.sk-photo{margin: 0; aspect-ratio: 4 / 3; border-radius: var(--sk-r-md); overflow: hidden; background: var(--sk-ice-2);}</style>\n</section>",
          "_cid": "vyjBDzkEsk",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-gallery1-1x"
