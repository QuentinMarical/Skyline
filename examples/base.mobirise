          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-cta1-20"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-positions1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-positions1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"range\" inline title=\"Positions\" name=\"jobs\" min=\"1\" max=\"5\" step=\"1\" value=\"3\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Open positions</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Click a title to read the details.</h3>\n            </div>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-9\">\n                <div class=\"accordion sk-faq\" id=\"sk-jobs-acc\">\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-1\" aria-expanded=\"true\" aria-controls=\"sk-job-1\">Safety <span class=\"sk-count ms-2\">(10)</span></button></h3>\n                        <div id=\"sk-job-1\" class=\"accordion-collapse collapse show\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Key responsibilities</h4>\n                                <ul><li><strong>Before:</strong> prepare and plan.</li><li><strong>During:</strong> run the activity on site.</li><li><strong>After:</strong> report and hand over.</li></ul>\n                                <h4 class=\"sk-sub\">Skills and profile</h4>\n                                <ul><li><strong>Know-how:</strong> relevant experience.</li><li><strong>Soft skills:</strong> teamwork and reliability.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"jobs > 1\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-2\" aria-expanded=\"false\" aria-controls=\"sk-job-2\">Logistics <span class=\"sk-count ms-2\">(4)</span></button></h3>\n                        <div id=\"sk-job-2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Key responsibilities</h4>\n                                <ul><li><strong>Before:</strong> prepare and plan.</li><li><strong>During:</strong> run the activity on site.</li><li><strong>After:</strong> report and hand over.</li></ul>\n                                <h4 class=\"sk-sub\">Skills and profile</h4>\n                                <ul><li><strong>Know-how:</strong> relevant experience.</li><li><strong>Soft skills:</strong> teamwork and reliability.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"jobs > 2\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-3\" aria-expanded=\"false\" aria-controls=\"sk-job-3\">Operations <span class=\"sk-count ms-2\">(5)</span></button></h3>\n                        <div id=\"sk-job-3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Key responsibilities</h4>\n                                <ul><li><strong>Before:</strong> prepare and plan.</li><li><strong>During:</strong> run the activity on site.</li><li><strong>After:</strong> report and hand over.</li></ul>\n                                <h4 class=\"sk-sub\">Skills and profile</h4>\n                                <ul><li><strong>Know-how:</strong> relevant experience.</li><li><strong>Soft skills:</strong> teamwork and reliability.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"jobs > 3\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-4\" aria-expanded=\"false\" aria-controls=\"sk-job-4\">Registration <span class=\"sk-count ms-2\">(6)</span></button></h3>\n                        <div id=\"sk-job-4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Key responsibilities</h4>\n                                <ul><li><strong>Before:</strong> prepare and plan.</li><li><strong>During:</strong> run the activity on site.</li><li><strong>After:</strong> report and hand over.</li></ul>\n                                <h4 class=\"sk-sub\">Skills and profile</h4>\n                                <ul><li><strong>Know-how:</strong> relevant experience.</li><li><strong>Soft skills:</strong> teamwork and reliability.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"jobs > 4\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-5\" aria-expanded=\"false\" aria-controls=\"sk-job-5\">Technology <span class=\"sk-count ms-2\">(2)</span></button></h3>\n                        <div id=\"sk-job-5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Key responsibilities</h4>\n                                <ul><li><strong>Before:</strong> prepare and plan.</li><li><strong>During:</strong> run the activity on site.</li><li><strong>After:</strong> report and hand over.</li></ul>\n                                <h4 class=\"sk-sub\">Skills and profile</h4>\n                                <ul><li><strong>Know-how:</strong> relevant experience.</li><li><strong>Soft skills:</strong> teamwork and reliability.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-faq .accordion-item{border: 0; background: rgba(181, 204, 232, .17); border-radius: var(--sk-r-md) !important; margin-bottom: .75rem; overflow: hidden;}.sk-faq .accordion-button{background: transparent; font-weight: 700; color: var(--sk-navy); box-shadow: none;}.sk-faq .accordion-button:not(.collapsed){color: var(--sk-navy); background: rgba(181, 204, 232, .35);}.sk-positions1 .accordion-body .sk-sub{font-size: 1rem; font-weight: 700; color: var(--sk-navy); margin: 1rem 0 .5rem;}.sk-positions1 .accordion-body .sk-sub:first-child{margin-top: 0;}.sk-count{color: var(--sk-muted); font-weight: 400;}</style>\n</section>",
          "_cid": "vyjBy3w5Lm",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-positions1-1l"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-notice1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-notice1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <select title=\"Style\" name=\"noticeStyle\">\n            <option value=\"note\" selected>Note</option>\n            <option value=\"alert\">Alert</option>\n            <option value=\"success\">Success</option>\n        </select>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-9\">\n                <div class=\"sk-alert\" role=\"note\" mbr-class=\"{'sk-alert--danger': noticeStyle == 'alert', 'sk-alert--success': noticeStyle == 'success'}\">\n                    <h4 class=\"sk-alert-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".sk-alert-title\">Please note</h4>\n                    <p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Use this banner for conditions, deadlines or important reminders.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-alert{border-radius: var(--sk-r-md); padding: 1.25rem 1.5rem; background: var(--sk-ice-2); border-left: 6px solid var(--sk-sky);}.sk-alert--danger{background: rgba(227, 5, 19, .14); border-left-color: var(--sk-red);}.sk-alert--success{background: #dff3e7; border-left-color: #17703f;}.sk-alert .sk-alert-title{font-weight: 700; color: var(--sk-navy); margin-bottom: .25rem;}</style>\n</section>",
          "_cid": "vyjByr2Oge",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-notice1-1m"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-venue1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-venue1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Access List\" name=\"showAccess\" checked>\n        <input type=\"checkbox\" title=\"Show Map Placeholder\" name=\"showMap\" checked>\n        <select title=\"Image Side\" name=\"imageSide\">\n            <option value=\"right\" selected>Right</option>\n            <option value=\"left\">Left</option>\n        </select>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row g-4 gx-lg-5 align-items-center\" mbr-class=\"{'flex-row-reverse': imageSide == 'left'}\">\n            <div class=\"col-12 col-lg-6\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">The venue</h2>\n                <p class=\"mbr-text mb-4 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Describe the venue: its size, its facilities, what makes it a good fit. One short paragraph is enough.</p>\n                <address class=\"sk-address mb-4 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-address\">123 Example Avenue<br>75000 City</address>\n                <ul class=\"sk-access list-unstyled mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showAccess\" mbr-list>\n                    <li mbr-text><strong>Metro:</strong> lines 1 and 2</li>\n                    <li mbr-text><strong>Train:</strong> lines A and B</li>\n                    <li mbr-text><strong>Bus:</strong> 12 and N34</li>\n                    <li mbr-text><strong>Car:</strong> motorway exit 5</li>\n                </ul>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <figure class=\"sk-figure mbr-figure mb-0\" mbr-if=\"showMap\"><img src=\"data:image/svg+xml;base64,\" alt=\"Venue\"></figure>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-address{font-style: normal; font-weight: 500; color: var(--sk-navy);}.sk-access li{margin-bottom: .5rem;}.sk-figure{margin: 0; border-radius: var(--sk-r-lg); overflow: hidden;}.sk-figure img{width: 100%; height: 100%; object-fit: cover; display: block;}</style>\n</section>",
          "_cid": "vyjBySJjsq",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-venue1-1n"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            }
          },
          "_name": "sk-cards1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-cards1\" data-bs-version=\"5.1\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <select title=\"Card Style\" name=\"cardStyle\">\n            <option value=\"soft\" selected>Soft</option>\n            <option value=\"ice\">Ice</option>\n            <option value=\"outline\">Outline</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Why join us</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Three reasons, one short sentence each.</h3>\n            </div>\n        </div>\n        <div class=\"row g-4\">\n            <div class=\"col-12 col-md-6\" mbr-class=\"{'col-lg-3': cardsAmount == '4', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"sk-card\" mbr-class=\"{'sk-card--ice': cardStyle == 'ice', 'sk-card--outline': cardStyle == 'outline'}\">\n                    <span mbr-if=\"showIcons\" mbr-icon class=\"sk-icon mbr-iconfont mbri-star\"></span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Feature one</h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Short description of the first feature. Keep it to two lines.</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-3': cardsAmount == '4', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"sk-card\" mbr-class=\"{'sk-card--ice': cardStyle == 'ice', 'sk-card--outline': cardStyle == 'outline'}\">\n                    <span mbr-if=\"showIcons\" mbr-icon class=\"sk-icon mbr-iconfont mbri-globe\"></span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Feature two</h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Short description of the second feature. Keep it to two lines.</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-3': cardsAmount == '4', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"sk-card\" mbr-class=\"{'sk-card--ice': cardStyle == 'ice', 'sk-card--outline': cardStyle == 'outline'}\">\n                    <span mbr-if=\"showIcons\" mbr-icon class=\"sk-icon mbr-iconfont mbri-users\"></span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Feature three</h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Short description of the third feature. Keep it to two lines.</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-3': cardsAmount == '4', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"sk-card\" mbr-class=\"{'sk-card--ice': cardStyle == 'ice', 'sk-card--outline': cardStyle == 'outline'}\">\n                    <span mbr-if=\"showIcons\" mbr-icon class=\"sk-icon mbr-iconfont mbri-calendar\"></span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Feature four</h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Short description of the fourth feature. Keep it to two lines.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-card{background: var(--sk-ice-3); border-radius: var(--sk-r-lg); padding: 2rem; height: 100%;}.sk-card--ice{background: var(--sk-ice-2);}.sk-card--outline{background: transparent; border: 2px solid var(--sk-ice);}.sk-card .sk-card-title{font-weight: 700; color: var(--sk-navy);}.sk-card .sk-icon{font-size: 2.5rem; color: var(--sk-sky); display: block; margin-bottom: 1rem;}</style>\n</section>",
          "_cid": "vyjBzft9Hc",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-cards1-1o"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-departments1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-departments1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"range\" inline title=\"Departments\" name=\"deptCount\" min=\"2\" max=\"6\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Our teams</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Who does what.</h3>\n            </div>\n        </div>\n        <div class=\"row g-4\">\n            <div class=\"col-12 col-md-6\">\n                <h4 class=\"sk-dept-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-dept-title\">ACCOUNTING</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">One short paragraph describing what this team does and why it matters.</p>\n            </div>\n            <div class=\"col-12 col-md-6\">\n                <h4 class=\"sk-dept-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-dept-title\">SAFETY</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">One short paragraph describing what this team does and why it matters.</p>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"deptCount > 2\">\n                <h4 class=\"sk-dept-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-dept-title\">STAGE</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">One short paragraph describing what this team does and why it matters.</p>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"deptCount > 3\">\n                <h4 class=\"sk-dept-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-dept-title\">TECHNOLOGY</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">One short paragraph describing what this team does and why it matters.</p>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"deptCount > 4\">\n                <h4 class=\"sk-dept-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-dept-title\">LOGISTICS</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">One short paragraph describing what this team does and why it matters.</p>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"deptCount > 5\">\n                <h4 class=\"sk-dept-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-dept-title\">COMMUNICATION</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">One short paragraph describing what this team does and why it matters.</p>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-dept-title{font-weight: 700; letter-spacing: .04em; color: var(--sk-navy);}</style>\n</section>",
          "_cid": "vyjBzG2IrC",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-departments1-1p"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-goodies1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-goodies1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Artist Credit\" name=\"showCredit\" checked>\n        <input type=\"checkbox\" title=\"Show Level Badge\" name=\"showLevel\" checked>\n        <select title=\"Items\" name=\"itemsAmount\">\n            <option value=\"4\">4</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Goodies</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Collect them all.</h3>\n            </div>\n        </div>\n        <div class=\"row g-4\">\n            <div class=\"col-6 col-md-4\" mbr-class=\"{'col-lg-3': itemsAmount == '4' || itemsAmount == '8', 'col-lg-4': itemsAmount == '6'}\">\n                <article class=\"sk-good\">\n                    <figure class=\"sk-good-img mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"T-shirt\"></figure>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-card-title\">T-shirt</h4>\n                    <p class=\"sk-credit mb-1 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCredit\" data-app-selector=\".sk-credit\">Illustration: Artist A</p>\n                    <span class=\"sk-badge mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLevel\">Level 2</span>\n                </article>\n            </div>\n            <div class=\"col-6 col-md-4\" mbr-class=\"{'col-lg-3': itemsAmount == '4' || itemsAmount == '8', 'col-lg-4': itemsAmount == '6'}\">\n                <article class=\"sk-good\">\n                    <figure class=\"sk-good-img mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Hoodie\"></figure>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-card-title\">Hoodie</h4>\n                    <p class=\"sk-credit mb-1 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCredit\" data-app-selector=\".sk-credit\">Illustration: Artist B</p>\n                    <span class=\"sk-badge mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLevel\">Level 3</span>\n                </article>\n            </div>\n            <div class=\"col-6 col-md-4\" mbr-class=\"{'col-lg-3': itemsAmount == '4' || itemsAmount == '8', 'col-lg-4': itemsAmount == '6'}\">\n                <article class=\"sk-good\">\n                    <figure class=\"sk-good-img mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Luggage tag\"></figure>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-card-title\">Luggage tag</h4>\n                    <p class=\"sk-credit mb-1 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCredit\" data-app-selector=\".sk-credit\">Illustration: Artist A</p>\n                    <span class=\"sk-badge mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLevel\">Level 1</span>\n                </article>\n            </div>\n            <div class=\"col-6 col-md-4\" mbr-class=\"{'col-lg-3': itemsAmount == '4' || itemsAmount == '8', 'col-lg-4': itemsAmount == '6'}\">\n                <article class=\"sk-good\">\n                    <figure class=\"sk-good-img mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Mug\"></figure>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-card-title\">Mug</h4>\n                    <p class=\"sk-credit mb-1 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCredit\" data-app-selector=\".sk-credit\">Illustration: Artist C</p>\n                    <span class=\"sk-badge mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLevel\">Level 1</span>\n                </article>\n            </div>\n            <div class=\"col-6 col-md-4\" mbr-class=\"{'col-lg-3': itemsAmount == '4' || itemsAmount == '8', 'col-lg-4': itemsAmount == '6'}\" mbr-if=\"itemsAmount == '6'\">\n                <article class=\"sk-good\">\n                    <figure class=\"sk-good-img mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Backpack\"></figure>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-card-title\">Backpack</h4>\n                    <p class=\"sk-credit mb-1 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCredit\" data-app-selector=\".sk-credit\">Illustration: Artist B</p>\n                    <span class=\"sk-badge mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLevel\">Level 3</span>\n                </article>\n            </div>\n            <div class=\"col-6 col-md-4\" mbr-class=\"{'col-lg-3': itemsAmount == '4' || itemsAmount == '8', 'col-lg-4': itemsAmount == '6'}\" mbr-if=\"itemsAmount == '6'\">\n                <article class=\"sk-good\">\n                    <figure class=\"sk-good-img mbr-figure\"><img src=\"data:image/svg+xml;base64,\" alt=\"Travel pillow\"></figure>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-card-title\">Travel pillow</h4>\n                    <p class=\"sk-credit mb-1 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCredit\" data-app-selector=\".sk-credit\">Illustration: Artist C</p>\n                    <span class=\"sk-badge mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLevel\">Level 2</span>\n                </article>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-badge{display: inline-block; padding: .25rem .75rem; border-radius: var(--sk-r-pill); background: var(--sk-red); color: var(--sk-white); font-size: .8rem; font-weight: 700;}.sk-good-img img{width: 100%; height: 100%; object-fit: cover; display: block;}.sk-good{height: 100%;}.sk-good-img{aspect-ratio: 1; margin: 0 0 .75rem; border-radius: var(--sk-r-md); overflow: hidden; background: var(--sk-ice-2);}.sk-credit{color: var(--sk-muted);}.sk-good .sk-badge{background: var(--sk-sky); color: var(--sk-navy);}</style>\n</section>",
          "_cid": "vyjBAxsVHR",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-goodies1-1q"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-perks1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-perks1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#f2f7fa\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-4 text-center mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Volunteer perks</h2>\n                <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-list>\n                    <li mbr-text>A reserved entry ticket</li>\n                    <li mbr-text>Exclusive goodies</li>\n                    <li mbr-text>Access to a staff lounge with snacks</li>\n                    <li mbr-text>And a few more surprises</li>\n                </ul>\n                <div class=\"mbr-section-btn text-center mt-4\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"sk-btn sk-btn-primary\" href=\"#\">Fill in the form to join the team</a></div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-btn{display: inline-flex; max-width: 100%; text-align: center; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.5rem; border-radius: var(--sk-r-pill); border: 2px solid transparent; font-weight: 500; text-decoration: none; transition: transform .15s, background-color .15s;}.sk-btn:hover{transform: translateY(-1px);}.sk-btn-primary{background: var(--sk-navy); color: var(--sk-white);}.sk-btn-primary:hover{background: #0d0da0; color: var(--sk-white);}.sk-check{list-style: none; padding: 0; margin: 1rem 0 1.5rem;}.sk-check li{padding-left: 1.75rem; position: relative; margin-bottom: .5rem;}.sk-check li::before{content: \"✓\"; position: absolute; left: 0; color: var(--sk-sky); font-weight: 700;}</style>\n</section>",
          "_cid": "vyjBB1OkvA",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-perks1-1r"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-steps1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-steps1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <select title=\"Steps\" name=\"stepsAmount\">\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">How it works</h2>\n            </div>\n        </div>\n        <div class=\"row g-4 text-center\">\n            <div class=\"col-12 col-md-6\" mbr-class=\"{'col-lg-3': stepsAmount == '4', 'col-lg-4': stepsAmount == '3'}\">\n                <div class=\"sk-step-number mbr-fonts-style\" mbr-theme-style=\"display-5\">1</div>\n                <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Create your account</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Describe the first step in one or two sentences.</p>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"stepsAmount > 1\" mbr-class=\"{'col-lg-3': stepsAmount == '4', 'col-lg-4': stepsAmount == '3'}\">\n                <div class=\"sk-step-number mbr-fonts-style\" mbr-theme-style=\"display-5\">2</div>\n                <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Choose your ticket</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Describe the second step in one or two sentences.</p>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"stepsAmount > 2\" mbr-class=\"{'col-lg-3': stepsAmount == '4', 'col-lg-4': stepsAmount == '3'}\">\n                <div class=\"sk-step-number mbr-fonts-style\" mbr-theme-style=\"display-5\">3</div>\n                <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Pay and confirm</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Describe the third step in one or two sentences.</p>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-3\" mbr-if=\"stepsAmount > 3\">\n                <div class=\"sk-step-number mbr-fonts-style\" mbr-theme-style=\"display-5\">4</div>\n                <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Enjoy the event</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Describe the fourth step in one or two sentences.</p>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-step-number{width: 3rem; height: 3rem; border-radius: 50%; background: var(--sk-navy); color: var(--sk-white); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; margin-bottom: 1rem;}</style>\n</section>",
          "_cid": "vyjBBsVCgW",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-steps1-1s"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            }
          },
          "_name": "sk-pricing1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-pricing1\" data-bs-version=\"5.1\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Badge\" name=\"showBadge\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <select title=\"Plans\" name=\"plansAmount\">\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#f2f7fa\" selected>\n        </fieldset>\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Tickets</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Pick the plan that suits you.</h3>\n            </div>\n        </div>\n        <div class=\"row g-4 justify-content-center\">\n            <div class=\"col-12 col-md-6\" mbr-class=\"{'col-lg-4': plansAmount == '3'}\">\n                <div class=\"sk-price-card\">\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Standard</h4>\n                    <div class=\"sk-price mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".sk-price\">€ 50</div>\n                    <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><li>Entry to all days</li><li>Welcome pack</li><li>Access to the schedule</li></ul>\n                    <div class=\"mbr-section-btn mt-auto\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"sk-btn sk-btn-primary\" href=\"#\">Choose</a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-class=\"{'col-lg-4': plansAmount == '3'}\">\n                <div class=\"sk-price-card sk-featured\">\n                    <span class=\"sk-badge align-self-start mb-2 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showBadge\">Most popular</span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Plus</h4>\n                    <div class=\"sk-price mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".sk-price\">€ 90</div>\n                    <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><li>Everything in Standard</li><li>Priority entry</li><li>Exclusive gift</li></ul>\n                    <div class=\"mbr-section-btn mt-auto\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"sk-btn sk-btn-primary\" href=\"#\">Choose</a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-4\" mbr-if=\"plansAmount == '3'\">\n                <div class=\"sk-price-card\">\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Premium</h4>\n                    <div class=\"sk-price mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".sk-price\">€ 150</div>\n                    <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><li>Everything in Plus</li><li>Reserved seating</li><li>Meet &amp; greet</li></ul>\n                    <div class=\"mbr-section-btn mt-auto\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"sk-btn sk-btn-primary\" href=\"#\">Choose</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-btn{display: inline-flex; max-width: 100%; text-align: center; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.5rem; border-radius: var(--sk-r-pill); border: 2px solid transparent; font-weight: 500; text-decoration: none; transition: transform .15s, background-color .15s;}.sk-btn:hover{transform: translateY(-1px);}.sk-btn-primary{background: var(--sk-navy); color: var(--sk-white);}.sk-btn-primary:hover{background: #0d0da0; color: var(--sk-white);}.sk-price-card{background: var(--sk-white); border-radius: var(--sk-r-lg); box-shadow: var(--sk-shadow); padding: 2rem; height: 100%; display: flex; flex-direction: column;}.sk-price-card.sk-featured{border: 3px solid var(--sk-red);}.sk-price{font-family: var(--sk-font-title); font-size: 2.5rem; color: #0094d4;}.sk-badge{display: inline-block; padding: .25rem .75rem; border-radius: var(--sk-r-pill); background: var(--sk-red); color: var(--sk-white); font-size: .8rem; font-weight: 700;}.sk-check{list-style: none; padding: 0; margin: 1rem 0 1.5rem;}.sk-check li{padding-left: 1.75rem; position: relative; margin-bottom: .5rem;}.sk-check li::before{content: \"✓\"; position: absolute; left: 0; color: var(--sk-sky); font-weight: 700;}</style>\n</section>",
          "_cid": "vyjBBWiU1Q",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
