{
  "settings": {
    "name": "Skyline Demo",
    "currentPage": "index.html",
    "theme": {
      "name": "startm5",
      "title": "StartM5",
      "styling": {
        "primaryColor": "#080866",
        "secondaryColor": "#38bdf5",
        "successColor": "#3a341c",
        "infoColor": "#320707",
        "warningColor": "#a0e2e1",
        "dangerColor": "#ffffff",
        "mainFont": "Inter",
        "display1Font": "Shrikhand",
        "display1Size": 5,
        "display2Font": "Shrikhand",
        "display2Size": 4,
        "display5Font": "Inter",
        "display5Size": 2,
        "display7Font": "Inter",
        "display7Size": 1.4,
        "display4Font": "Inter",
        "display4Size": "1.4",
        "isRoundedImages": true,
        "isRoundedButtons": true,
        "isLargeButtons": true,
        "isGhostButtonBorder": true,
        "underlinedLinks": false,
        "isAnimatedOnScroll": false,
        "isScrollToTopButton": false
      },
      "additionalSetColors": [
        "#ffa25b",
        "#2b7a69",
        "#164fd3",
        "#ff7d19",
        "#385493",
        "#086784",
        "#fe8d01"
      ]
    },
    "path": "@PROJECT_PATH@",
    "versionFirst": "5.8.25",
    "siteFonts": [
      {
        "css": "'Shrikhand', sans-serif",
        "name": "Shrikhand",
        "url": "https://fonts.googleapis.com/css?family=Shrikhand:400"
      },
      {
        "css": "'Inter', sans-serif",
        "name": "Inter",
        "url": "https://fonts.googleapis.com/css?family=Inter:100,200,300,400,500,600,700,800,900,100i,200i,300i,400i,500i,600i,700i,800i,900i"
      }
    ],
    "uniqCompNum": 160,
    "versionPublish": "6.1.12",
    "imageResize": true,
    "chatbutton": {},
    "favicon": false,
    "mbrsiteDomain": "ktjot1jvkl",
    "usedWebp": false,
    "cssOptimize": false,
    "lazyLoad": false,
    "robotsSwitcher": false,
    "sitemapSwitcher": false,
    "sitemapSwitcherAuto": false,
    "siteUrl": false,
    "cookiesAlert": false,
    "gdpr": false,
    "pwa-switcher": false,
    "screenshot": "screenshot.png",
    "publishChangesOnly": true
  },
  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Accueil",
        "meta_descr": "Festival Horizon : quatre jours de rencontres, d'ateliers et de spectacles.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {},
          "_name": "sk-menu1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-menu sk-menu1\" data-bs-version=\"5.1\" global=\"\" once=\"\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Button\" name=\"showButton\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Menu Items\" name=\"menuItems\" min=\"1\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-expand-lg container\" mbr-style=\"{'background-color': bgColor}\">\n        <a class=\"navbar-brand mbr-fonts-style\" mbr-theme-style=\"display-5\" href=\"index.html\" data-app-selector=\".navbar-brand\">Horizon</a>\n        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-nav\" aria-controls=\"sk-nav\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n            <span class=\"navbar-toggler-icon\"></span>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"sk-nav\">\n            <ul class=\"navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center\" mbr-list=\"\" mbr-list-grow=\"menuItems\">\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"index.html\">Accueil</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"about.html\">À propos</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"programme.html\">Programme</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"tickets.html\">Billets</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"faq.html\">FAQ</a></li>\n            </ul>\n            <div class=\"mbr-section-btn ms-lg-3\" mbr-if=\"showButton\" mbr-buttons=\"\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                <a class=\"sk-btn sk-btn-primary\" href=\"register.html\">S'inscrire</a>\n            </div>\n        </div>\n    </nav>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-btn{display: inline-flex; max-width: 100%; text-align: center; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.5rem; border-radius: var(--sk-r-pill); border: 2px solid transparent; font-weight: 500; text-decoration: none; transition: transform .15s, background-color .15s;}.sk-btn:hover{transform: translateY(-1px);}.sk-btn.sk-btn-primary{background: var(--sk-navy); color: var(--sk-white);}.sk-btn.sk-btn-primary:hover{background: #0d0da0; color: var(--sk-white);}.sk-menu{position: sticky; top: 0; z-index: 1000; background: var(--sk-white); box-shadow: 0 1px 0 rgba(0,0,0,.06);}.sk-menu .navbar{min-height: 64px;}.sk-menu .nav-link{color: #444; font-weight: 500;}.sk-menu .nav-link:hover{color: var(--sk-navy);}.sk-menu .navbar-brand{font-family: var(--sk-font-title); color: var(--sk-navy); font-size: 1.5rem;}</style>\n</section>\n",
          "_cid": "vyjBviDVkq",
          "_protectedParams": [],
          "_global": true,
          "_once": true,
          "_params": {},
          "_anchor": "sk-menu1-26"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            }
          },
          "_name": "sk-hero1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-hero sk-hero1\" data-bs-version=\"5.1\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'sk-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n\n        <input type=\"checkbox\" title=\"Show Capsule\" name=\"showCapsule\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background.jpg\" selected parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#dce7f5\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center text-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"sk-capsule mb-4 mbr-fonts-style\" mbr-if=\"showCapsule\" mbr-theme-style=\"display-4\" data-app-selector=\".sk-capsule\">\n                    <span>12 – 15 juin 2027</span><span>·</span><span>Centre des Congrès Rivage</span>\n                </div>\n                <h1 class=\"sk-title mbr-section-title mb-4 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">Festival Horizon</h1>\n                <p class=\"sk-subtitle mbr-text mb-5 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\">Quatre jours de rencontres, d'ateliers et de spectacles au bord de la mer. Embarquez avec nous !</p>\n                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\">\n                    <a class=\"sk-btn sk-btn-primary me-2 mb-2\" href=\"tickets.html\">Réserver mon billet</a>\n                    <a class=\"sk-btn sk-btn-outline mb-2\" href=\"programme.html\">Voir le programme</a>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-btn{display: inline-flex; max-width: 100%; text-align: center; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.5rem; border-radius: var(--sk-r-pill); border: 2px solid transparent; font-weight: 500; text-decoration: none; transition: transform .15s, background-color .15s;}.sk-btn:hover{transform: translateY(-1px);}.sk-btn.sk-btn-primary{background: var(--sk-navy); color: var(--sk-white);}.sk-btn.sk-btn-primary:hover{background: #0d0da0; color: var(--sk-white);}.sk-btn.sk-btn-outline{border-color: currentColor; background: transparent; color: var(--sk-navy);}.sk-hero{display: flex; align-items: center; background-size: cover; background-position: center;}.sk-hero.sk-fullscreen{min-height: 100vh;}.sk-hero .sk-title{font-size: clamp(2.25rem, 6vw, 4.5rem);}.sk-capsule{display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1.25rem; border-radius: 80px; background: rgba(255,255,255,.6); backdrop-filter: blur(12px); color: var(--sk-navy); font-weight: 500;}</style>\n</section>",
          "_cid": "qFZp2zAHnk",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-hero1-27"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-text1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-text1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Signature\" name=\"showSignature\" checked>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-9 text-center\">\n                <h2 class=\"sk-title mbr-section-title mb-4 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Bienvenue à bord</h2>\n                <p class=\"mbr-text mb-4 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\">Le Festival Horizon réunit chaque année des passionnés de toute la France pour quatre jours de rencontres, d'ateliers et de spectacles. Que vous veniez seul, entre amis ou en famille, il y a une place pour vous à bord.</p>\n                <p class=\"sk-signature mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSignature\" data-app-selector=\".sk-signature\">L'équipe Horizon vous attend !</p>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-signature{font-weight: 700; color: var(--sk-navy);}</style>\n</section>",
          "_cid": "JDURi2fO5Q",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-text1-28"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            }
          },
          "_name": "sk-cards1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-cards1\" data-bs-version=\"5.1\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <select title=\"Card Style\" name=\"cardStyle\">\n            <option value=\"soft\" selected>Soft</option>\n            <option value=\"ice\">Ice</option>\n            <option value=\"outline\">Outline</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Pourquoi venir ?</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Trois bonnes raisons de réserver dès maintenant.</h3>\n            </div>\n        </div>\n        <div class=\"row g-4\">\n            <div class=\"col-12 col-md-6\" mbr-class=\"{'col-lg-3': cardsAmount == '4', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"sk-card\" mbr-class=\"{'sk-card--ice': cardStyle == 'ice', 'sk-card--outline': cardStyle == 'outline'}\">\n                    <span mbr-if=\"showIcons\" mbr-icon class=\"sk-icon mbr-iconfont mbri-star\"></span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Rencontres</h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Retrouvez la communauté et faites de nouvelles rencontres dans un cadre convivial.</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-3': cardsAmount == '4', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"sk-card\" mbr-class=\"{'sk-card--ice': cardStyle == 'ice', 'sk-card--outline': cardStyle == 'outline'}\">\n                    <span mbr-if=\"showIcons\" mbr-icon class=\"sk-icon mbr-iconfont mbri-globe\"></span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Ateliers</h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Initiez-vous, créez et partagez vos talents avec des animateurs passionnés.</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-3': cardsAmount == '4', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"sk-card\" mbr-class=\"{'sk-card--ice': cardStyle == 'ice', 'sk-card--outline': cardStyle == 'outline'}\">\n                    <span mbr-if=\"showIcons\" mbr-icon class=\"sk-icon mbr-iconfont mbri-users\"></span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Spectacles</h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Concerts, défilés et soirées pour finir chaque journée en beauté.</p>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"cardsAmount > 3\" mbr-class=\"{'col-lg-3': cardsAmount == '4', 'col-lg-4': cardsAmount == '3'}\">\n                <div class=\"sk-card\" mbr-class=\"{'sk-card--ice': cardStyle == 'ice', 'sk-card--outline': cardStyle == 'outline'}\">\n                    <span mbr-if=\"showIcons\" mbr-icon class=\"sk-icon mbr-iconfont mbri-calendar\"></span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Feature four</h4>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Short description of the fourth feature. Keep it to two lines.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-card{background: var(--sk-ice-3); border-radius: var(--sk-r-lg); padding: 2rem; height: 100%;}.sk-card--ice{background: var(--sk-ice-2);}.sk-card--outline{background: transparent; border: 2px solid var(--sk-ice);}.sk-card .sk-card-title{font-weight: 700; color: var(--sk-navy);}.sk-card .sk-icon{font-size: 2.5rem; color: var(--sk-sky); display: block; margin-bottom: 1rem;}</style>\n</section>",
          "_cid": "myReN8htf6",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-cards1-29"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-steps1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-steps1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <select title=\"Steps\" name=\"stepsAmount\">\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected=\"\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Comment s'inscrire ?</h2>\n            </div>\n        </div>\n        <div class=\"row g-4 text-center\">\n            <div class=\"col-12 col-md-6\" mbr-class=\"{'col-lg-3': stepsAmount == '4', 'col-lg-4': stepsAmount == '3'}\">\n                <div class=\"sk-step-number mbr-fonts-style\" mbr-theme-style=\"display-5\">1</div>\n                <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Créez votre compte</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Renseignez vos informations en quelques minutes.</p>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"stepsAmount > 1\" mbr-class=\"{'col-lg-3': stepsAmount == '4', 'col-lg-4': stepsAmount == '3'}\">\n                <div class=\"sk-step-number mbr-fonts-style\" mbr-theme-style=\"display-5\">2</div>\n                <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Choisissez votre billet</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Sélectionnez la formule qui vous convient.</p>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-if=\"stepsAmount > 2\" mbr-class=\"{'col-lg-3': stepsAmount == '4', 'col-lg-4': stepsAmount == '3'}\">\n                <div class=\"sk-step-number mbr-fonts-style\" mbr-theme-style=\"display-5\">3</div>\n                <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Payez et confirmez</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Réglez en ligne et recevez votre confirmation par e-mail.</p>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-3\" mbr-if=\"stepsAmount > 3\">\n                <div class=\"sk-step-number mbr-fonts-style\" mbr-theme-style=\"display-5\">4</div>\n                <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Profitez du festival</h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Présentez votre billet à l'entrée et laissez-vous embarquer.</p>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-step-number{width: 3rem; height: 3rem; border-radius: 50%; background: var(--sk-navy); color: var(--sk-white); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; margin-bottom: 1rem;}</style>\n</section>",
          "_cid": "x2eyDnkkFt",
          "_protectedParams": [],
          "_global": false,
