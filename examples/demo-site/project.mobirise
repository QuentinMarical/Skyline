    "faq.html": {
      "settings": {
        "title": "FAQ",
        "meta_descr": "Les questions fréquentes.",
        "order": "4"
      },
      "components": [
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {},
          "_name": "sk-menu1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-menu sk-menu1\" data-bs-version=\"5.1\" global=\"\" once=\"\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Button\" name=\"showButton\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Menu Items\" name=\"menuItems\" min=\"1\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-expand-lg container\" mbr-style=\"{'background-color': bgColor}\">\n        <a class=\"navbar-brand mbr-fonts-style\" mbr-theme-style=\"display-5\" href=\"index.html\" data-app-selector=\".navbar-brand\">Horizon</a>\n        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-nav\" aria-controls=\"sk-nav\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n            <span class=\"navbar-toggler-icon\"></span>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"sk-nav\">\n            <ul class=\"navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center\" mbr-list=\"\" mbr-list-grow=\"menuItems\">\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"index.html\">Accueil</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"about.html\">À propos</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"programme.html\">Programme</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"tickets.html\">Billets</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"faq.html\">FAQ</a></li>\n            </ul>\n            <div class=\"mbr-section-btn ms-lg-3\" mbr-if=\"showButton\" mbr-buttons=\"\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                <a class=\"sk-btn sk-btn-primary\" href=\"register.html\">S'inscrire</a>\n            </div>\n        </div>\n    </nav>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-btn{display: inline-flex; max-width: 100%; text-align: center; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.5rem; border-radius: var(--sk-r-pill); border: 2px solid transparent; font-weight: 500; text-decoration: none; transition: transform .15s, background-color .15s;}.sk-btn:hover{transform: translateY(-1px);}.sk-btn.sk-btn-primary{background: var(--sk-navy); color: var(--sk-white);}.sk-btn.sk-btn-primary:hover{background: #0d0da0; color: var(--sk-white);}.sk-menu{position: sticky; top: 0; z-index: 1000; background: var(--sk-white); box-shadow: 0 1px 0 rgba(0,0,0,.06);}.sk-menu .navbar{min-height: 64px;}.sk-menu .nav-link{color: #444; font-weight: 500;}.sk-menu .nav-link:hover{color: var(--sk-navy);}.sk-menu .navbar-brand{font-family: var(--sk-font-title); color: var(--sk-navy); font-size: 1.5rem;}</style>\n</section>\n",
          "_cid": "vyjBviDVkq",
          "_protectedParams": [],
          "_global": true,
          "_once": true,
          "_params": {},
          "_anchor": "sk-menu1-2y"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-faq1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-faq sk-faq1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"range\" inline title=\"Questions\" name=\"questions\" min=\"1\" max=\"6\" step=\"1\" value=\"6\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title text-center mb-5 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Questions fréquentes</h2>\n                <div class=\"accordion\" id=\"sk-faq-acc\">\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-1\" aria-expanded=\"true\" aria-controls=\"sk-faq-1\">Où se déroule le festival ?</button></h3>\n                        <div id=\"sk-faq-1\" class=\"accordion-collapse collapse show\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Au Centre des Congrès Rivage, 12 avenue de la Plage à Rivage-sur-Mer. Tous les détails d'accès sont sur la page « À propos ».</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 1\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-2\" aria-expanded=\"false\" aria-controls=\"sk-faq-2\">Puis-je être remboursé(e) ?</button></h3>\n                        <div id=\"sk-faq-2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Les billets sont remboursables jusqu'à trente jours avant l'événement, sur simple demande par e-mail.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 2\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-3\" aria-expanded=\"false\" aria-controls=\"sk-faq-3\">Y a-t-il une limite d'âge ?</button></h3>\n                        <div id=\"sk-faq-3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Le festival est ouvert à tous. Les mineurs doivent être accompagnés d'un adulte.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 3\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-4\" aria-expanded=\"false\" aria-controls=\"sk-faq-4\">Comment contacter l'équipe ?</button></h3>\n                        <div id=\"sk-faq-4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Utilisez le formulaire de la page Contact : nous répondons sous deux jours.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 4\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-5\" aria-expanded=\"false\" aria-controls=\"sk-faq-5\">Puis-je venir en transports en commun ?</button></h3>\n                        <div id=\"sk-faq-5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Oui : le tram T2 et plusieurs lignes de bus desservent le centre des congrès.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 5\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-6\" aria-expanded=\"false\" aria-controls=\"sk-faq-6\">Comment devenir bénévole ?</button></h3>\n                        <div id=\"sk-faq-6\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Rendez-vous sur la page Recrutement et remplissez le formulaire.</div></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-faq .accordion-item{border: 0; background: rgba(181, 204, 232, .17); border-radius: var(--sk-r-md) !important; margin-bottom: .75rem; overflow: hidden;}.sk-faq .accordion-button{background: transparent; font-weight: 700; color: var(--sk-navy); box-shadow: none;}.sk-faq .accordion-button:not(.collapsed){color: var(--sk-navy); background: rgba(181, 204, 232, .35);}</style>\n</section>",
          "_cid": "V4KkzjIlLb",
          "_protectedParams": [],
