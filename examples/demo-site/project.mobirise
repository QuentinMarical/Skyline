        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-tiers1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-tiers1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show\" includes previous\"=\"\" note\"=\"\" name=\"showIncludes\" checked>\n        <select title=\"Levels\" name=\"levelsAmount\">\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Niveaux de soutien</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Chaque niveau inclut les avantages du précédent.</h3>\n            </div>\n        </div>\n        <div class=\"row g-4 justify-content-center\">\n            <div class=\"col-12 col-md-6 col-lg-4\">\n                <div class=\"sk-tier\">\n                    <span class=\"sk-badge mb-2 mbr-fonts-style\" mbr-theme-style=\"display-4\">Niveau 1</span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Ami</h4>\n                    <div class=\"sk-price mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".sk-price\">+ 30 €</div>\n                    <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><li>Votre nom sur le mur des soutiens</li><li>Tote bag exclusif</li></ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-4\" mbr-if=\"levelsAmount > 1\">\n                <div class=\"sk-tier\">\n                    <span class=\"sk-badge mb-2 mbr-fonts-style\" mbr-theme-style=\"display-4\">Niveau 2</span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Soutien</h4>\n                    <div class=\"sk-price mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".sk-price\">+ 60 €</div>\n                    <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><li>Tout le niveau Ami</li><li>T-shirt en édition limitée</li></ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-4\" mbr-if=\"levelsAmount > 2\">\n                <div class=\"sk-tier sk-tier--top\">\n                    <span class=\"sk-badge mb-2 mbr-fonts-style\" mbr-theme-style=\"display-4\">Niveau 3</span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Mécène</h4>\n                    <div class=\"sk-price mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".sk-price\">+ 120 €</div>\n                    <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><li>Tout le niveau Soutien</li><li>Accès anticipé aux cérémonies</li><li>Places réservées</li></ul>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-price{font-family: var(--sk-font-title); font-size: 2.5rem; color: #0094d4;}.sk-badge{display: inline-block; padding: .25rem .75rem; border-radius: var(--sk-r-pill); background: var(--sk-red); color: var(--sk-white); font-size: .8rem; font-weight: 700;}.sk-check{list-style: none; padding: 0; margin: 1rem 0 1.5rem;}.sk-check li{padding-left: 1.75rem; position: relative; margin-bottom: .5rem;}.sk-check li::before{content: \"✓\"; position: absolute; left: 0; color: var(--sk-sky); font-weight: 700;}.sk-tier{background: var(--sk-ice-2); border-radius: var(--sk-r-lg); padding: 2rem; height: 100%;}.sk-tier--top{background: var(--sk-navy); color: var(--sk-white);}.sk-tier--top .sk-card-title{color: var(--sk-white);}.sk-tier--top .sk-price{color: var(--sk-sky);}</style>\n</section>",
