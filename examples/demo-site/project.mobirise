      ]
    },
    "tickets.html": {
      "settings": {
        "title": "Billets",
        "meta_descr": "Billets, chambres, niveaux de soutien et goodies.",
        "order": "3"
      },
      "components": [
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {},
          "_name": "sk-menu1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-menu sk-menu1\" data-bs-version=\"5.1\" global=\"\" once=\"\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Button\" name=\"showButton\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Menu Items\" name=\"menuItems\" min=\"1\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-expand-lg container\" mbr-style=\"{'background-color': bgColor}\">\n        <a class=\"navbar-brand mbr-fonts-style\" mbr-theme-style=\"display-5\" href=\"index.html\" data-app-selector=\".navbar-brand\">Horizon</a>\n        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-nav\" aria-controls=\"sk-nav\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n            <span class=\"navbar-toggler-icon\"></span>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"sk-nav\">\n            <ul class=\"navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center\" mbr-list=\"\" mbr-list-grow=\"menuItems\">\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"index.html\">Accueil</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"about.html\">À propos</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"programme.html\">Programme</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"tickets.html\">Billets</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"faq.html\">FAQ</a></li>\n            </ul>\n            <div class=\"mbr-section-btn ms-lg-3\" mbr-if=\"showButton\" mbr-buttons=\"\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                <a class=\"sk-btn sk-btn-primary\" href=\"register.html\">S'inscrire</a>\n            </div>\n        </div>\n    </nav>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-btn{display: inline-flex; max-width: 100%; text-align: center; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.5rem; border-radius: var(--sk-r-pill); border: 2px solid transparent; font-weight: 500; text-decoration: none; transition: transform .15s, background-color .15s;}.sk-btn:hover{transform: translateY(-1px);}.sk-btn.sk-btn-primary{background: var(--sk-navy); color: var(--sk-white);}.sk-btn.sk-btn-primary:hover{background: #0d0da0; color: var(--sk-white);}.sk-menu{position: sticky; top: 0; z-index: 1000; background: var(--sk-white); box-shadow: 0 1px 0 rgba(0,0,0,.06);}.sk-menu .navbar{min-height: 64px;}.sk-menu .nav-link{color: #444; font-weight: 500;}.sk-menu .nav-link:hover{color: var(--sk-navy);}.sk-menu .navbar-brand{font-family: var(--sk-font-title); color: var(--sk-navy); font-size: 1.5rem;}</style>\n</section>\n",
          "_cid": "vyjBviDVkq",
          "_protectedParams": [],
          "_global": true,
          "_once": true,
          "_params": {},
          "_anchor": "sk-menu1-2q"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            }
          },
          "_name": "sk-pricing1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-pricing1\" data-bs-version=\"5.1\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Badge\" name=\"showBadge\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <select title=\"Plans\" name=\"plansAmount\">\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#f2f7fa\" selected>\n        </fieldset>\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Billets</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Choisissez la formule qui vous convient.</h3>\n            </div>\n        </div>\n        <div class=\"row g-4 justify-content-center\">\n            <div class=\"col-12 col-md-6\" mbr-class=\"{'col-lg-4': plansAmount == '3'}\">\n                <div class=\"sk-price-card\">\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Pass Standard</h4>\n                    <div class=\"sk-price mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".sk-price\">50 €</div>\n                    <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><li>Accès aux quatre jours</li><li>Pack de bienvenue</li><li>Accès au programme complet</li></ul>\n                    <div class=\"mbr-section-btn mt-auto\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"sk-btn sk-btn-primary\" href=\"register.html\">Choisir</a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6\" mbr-class=\"{'col-lg-4': plansAmount == '3'}\">\n                <div class=\"sk-price-card sk-featured\">\n                    <span class=\"sk-badge align-self-start mb-2 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showBadge\">Le plus choisi</span>\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Pass Plus</h4>\n                    <div class=\"sk-price mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".sk-price\">90 €</div>\n                    <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><li>Tout le pass Standard</li><li>Entrée prioritaire</li><li>Cadeau exclusif</li></ul>\n                    <div class=\"mbr-section-btn mt-auto\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"sk-btn sk-btn-primary\" href=\"register.html\">Choisir</a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-4\" mbr-if=\"plansAmount == '3'\">\n                <div class=\"sk-price-card\">\n                    <h4 class=\"sk-card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".sk-card-title\">Pass Premium</h4>\n                    <div class=\"sk-price mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".sk-price\">150 €</div>\n                    <ul class=\"sk-check mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><li>Tout le pass Plus</li><li>Places réservées</li><li>Rencontre avec les invités</li></ul>\n                    <div class=\"mbr-section-btn mt-auto\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"sk-btn sk-btn-primary\" href=\"register.html\">Choisir</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-btn{display: inline-flex; max-width: 100%; text-align: center; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.5rem; border-radius: var(--sk-r-pill); border: 2px solid transparent; font-weight: 500; text-decoration: none; transition: transform .15s, background-color .15s;}.sk-btn:hover{transform: translateY(-1px);}.sk-btn.sk-btn-primary{background: var(--sk-navy); color: var(--sk-white);}.sk-btn.sk-btn-primary:hover{background: #0d0da0; color: var(--sk-white);}.sk-price-card{background: var(--sk-white); border-radius: var(--sk-r-lg); box-shadow: var(--sk-shadow); padding: 2rem; height: 100%; display: flex; flex-direction: column;}.sk-price-card.sk-featured{border: 3px solid var(--sk-red);}.sk-price{font-family: var(--sk-font-title); font-size: 2.5rem; color: #0094d4;}.sk-badge{display: inline-block; padding: .25rem .75rem; border-radius: var(--sk-r-pill); background: var(--sk-red); color: var(--sk-white); font-size: .8rem; font-weight: 700;}.sk-check{list-style: none; padding: 0; margin: 1rem 0 1.5rem;}.sk-check li{padding-left: 1.75rem; position: relative; margin-bottom: .5rem;}.sk-check li::before{content: \"✓\"; position: absolute; left: 0; color: var(--sk-sky); font-weight: 700;}</style>\n</section>",
          "_cid": "eVXXllvYlK",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-pricing1-2r"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-table1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-table1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Note\" name=\"showNote\" checked>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#f2f7fa\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Tarifs des chambres</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Prix par personne et par nuit.</h3>\n            </div>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"table-responsive\">\n                    <table class=\"sk-table table mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                        <thead><tr><th scope=\"col\">Type de chambre</th><th scope=\"col\">1 personne</th><th scope=\"col\">2 personnes</th><th scope=\"col\">3 personnes</th></tr></thead>\n                        <tbody>\n                            <tr><th scope=\"row\">Chambre standard</th><td>120 €</td><td>90 €</td><td>—</td></tr>\n                            <tr><th scope=\"row\">Chambre confort</th><td>150 €</td><td>110 €</td><td>95 €</td></tr>\n                        </tbody>\n                    </table>\n                </div>\n                <p class=\"sk-note mt-3 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showNote\" data-app-selector=\".sk-note\">À noter : les prix incluent les taxes et le petit-déjeuner. Des conditions s'appliquent en cas de partage.</p>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-table{--bs-table-bg: transparent; border-collapse: separate; border-spacing: 0; background: var(--sk-white); border-radius: var(--sk-r-md); overflow: hidden;}.sk-table thead th{background: #d6eefc; color: #0094d4; font-weight: 700; border: 0;}.sk-table tbody tr:nth-child(even) > *{background: var(--sk-ice-3);}.sk-table th[scope=\"row\"]{color: var(--sk-navy);}.sk-note{color: var(--sk-muted);}</style>\n</section>",
          "_cid": "1XeoXEMk3T",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-table1-2s"
