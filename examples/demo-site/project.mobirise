          "_anchor": "sk-menu1-3e"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-form1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-form1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Phone Field\" name=\"showPhone\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#f2f7fa\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Contactez-nous</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Nous répondons en général sous deux jours.</h3>\n            </div>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div mbr-form class=\"col-12 col-lg-8\">\n                <div data-form-alert hidden>Merci ! Votre message a bien été envoyé.</div>\n                <form class=\"mbr-form sk-form\" action method=\"post\" name=\"Contact Form\">\n                    <div class=\"row g-3\">\n                        <div class=\"col-md-6\"><label class=\"form-label\" for=\"sk-name\">Nom</label><input class=\"form-control\" type=\"text\" name=\"name\" id=\"sk-name\" required></div>\n                        <div class=\"col-md-6\"><label class=\"form-label\" for=\"sk-email\">E-mail</label><input class=\"form-control\" type=\"email\" name=\"email\" id=\"sk-email\" required></div>\n                        <div class=\"col-12\" mbr-if=\"showPhone\"><label class=\"form-label\" for=\"sk-phone\">Téléphone</label><input class=\"form-control\" type=\"tel\" name=\"phone\" id=\"sk-phone\"></div>\n                        <div class=\"col-12\"><label class=\"form-label\" for=\"sk-message\">Message</label><textarea class=\"form-control\" name=\"message\" id=\"sk-message\" rows=\"5\"></textarea></div>\n                        <div class=\"col-12 text-center mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><button type=\"submit\" class=\"sk-btn sk-btn-primary\">Envoyer</button></div>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-btn{display: inline-flex; max-width: 100%; text-align: center; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.5rem; border-radius: var(--sk-r-pill); border: 2px solid transparent; font-weight: 500; text-decoration: none; transition: transform .15s, background-color .15s;}.sk-btn:hover{transform: translateY(-1px);}.sk-btn.sk-btn-primary{background: var(--sk-navy); color: var(--sk-white);}.sk-btn.sk-btn-primary:hover{background: #0d0da0; color: var(--sk-white);}.sk-form .form-label{font-weight: 500; color: var(--sk-navy);}.sk-form .form-control{border: 1px solid var(--sk-ice); border-radius: var(--sk-r-sm); padding: .75rem 1rem;}.sk-form .form-control:focus{border-color: var(--sk-navy); box-shadow: 0 0 0 .2rem rgba(56, 189, 245, .3);}</style>\n</section>",
          "_cid": "ZdICu8diwZ",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-form1-3f"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-venue1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-venue1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Access List\" name=\"showAccess\" checked>\n        <input type=\"checkbox\" title=\"Show Map Placeholder\" name=\"showMap\" checked>\n        <select title=\"Image Side\" name=\"imageSide\">\n            <option value=\"right\">Right</option>\n            <option value=\"left\" selected=\"\">Left</option>\n        </select>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row g-4 gx-lg-5 align-items-center\" mbr-class=\"{'flex-row-reverse': imageSide == 'left'}\">\n            <div class=\"col-12 col-lg-6\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Nous trouver</h2>\n                <p class=\"mbr-text mb-4 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Venez nous rendre visite au Centre des Congrès Rivage, en bord de mer.</p>\n                <address class=\"sk-address mb-4 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".sk-address\">12 avenue de la Plage<br>00000 Rivage-sur-Mer</address>\n                <ul class=\"sk-access list-unstyled mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showAccess\" mbr-list>\n                    <li mbr-text><strong>Tram :</strong> ligne T2</li>\n                    <li mbr-text><strong>Train :</strong> gare de Rivage-sur-Mer</li>\n                    <li mbr-text><strong>Bus :</strong> lignes 12 et N34</li>\n                    <li mbr-text><strong>Voiture :</strong> autoroute, sortie 5</li>\n                </ul>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <figure class=\"sk-figure mbr-figure mb-0\" mbr-if=\"showMap\"><img src=\"data:image/svg+xml;base64,\" alt=\"Venue\"></figure>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-address{font-style: normal; font-weight: 500; color: var(--sk-navy);}.sk-access li{margin-bottom: .5rem;}.sk-figure{margin: 0; border-radius: var(--sk-r-lg); overflow: hidden;}.sk-figure img{width: 100%; height: 100%; object-fit: cover; display: block;}</style>\n</section>",
          "_cid": "PTW1IlDN9b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-venue1-3g"
