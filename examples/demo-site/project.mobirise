          "_anchor": "sk-menu1-3i"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-text1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-text1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Signature\" name=\"showSignature\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-9 text-center\">\n                <h2 class=\"sk-title mbr-section-title mb-4 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Règlement</h2>\n                <p class=\"mbr-text mb-4 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\">Merci de lire attentivement le règlement : il garantit un événement agréable et sûr pour tous.</p>\n                <p class=\"sk-signature mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSignature\" data-app-selector=\".sk-signature\">The team is waiting for you!</p>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-signature{font-weight: 700; color: var(--sk-navy);}</style>\n</section>",
          "_cid": "xZmzIxUKQR",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-text1-3j"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-faq1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-faq sk-faq1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"range\" inline title=\"Questions\" name=\"questions\" min=\"1\" max=\"6\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title text-center mb-5 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Règlement de l'événement</h2>\n                <div class=\"accordion\" id=\"sk-faq-acc\">\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-1\" aria-expanded=\"true\" aria-controls=\"sk-faq-1\">Comportement</button></h3>\n                        <div id=\"sk-faq-1\" class=\"accordion-collapse collapse show\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Chacun doit respecter les autres participants, les bénévoles et le personnel du lieu. Tout comportement agressif ou discriminatoire est interdit.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 1\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-2\" aria-expanded=\"false\" aria-controls=\"sk-faq-2\">Sécurité</button></h3>\n                        <div id=\"sk-faq-2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Les consignes du staff doivent être suivies en toutes circonstances. Les issues de secours doivent rester dégagées.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 2\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-3\" aria-expanded=\"false\" aria-controls=\"sk-faq-3\">Objets interdits</button></h3>\n                        <div id=\"sk-faq-3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Les objets dangereux, les boissons en bouteille de verre et les animaux (hors chiens guides) ne sont pas admis.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 3\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-4\" aria-expanded=\"false\" aria-controls=\"sk-faq-4\">Photos et vidéos</button></h3>\n                        <div id=\"sk-faq-4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Les prises de vue sont autorisées dans les espaces publics, sous réserve du consentement des personnes photographiées.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 4\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-5\" aria-expanded=\"false\" aria-controls=\"sk-faq-5\">Question supplémentaire ?</button></h3>\n                        <div id=\"sk-faq-5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Réponse à compléter.</div></div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"questions > 5\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-faq-6\" aria-expanded=\"false\" aria-controls=\"sk-faq-6\">Question supplémentaire ?</button></h3>\n                        <div id=\"sk-faq-6\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-faq-acc\"><div class=\"accordion-body mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Réponse à compléter.</div></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-faq .accordion-item{border: 0; background: rgba(181, 204, 232, .17); border-radius: var(--sk-r-md) !important; margin-bottom: .75rem; overflow: hidden;}.sk-faq .accordion-button{background: transparent; font-weight: 700; color: var(--sk-navy); box-shadow: none;}.sk-faq .accordion-button:not(.collapsed){color: var(--sk-navy); background: rgba(181, 204, 232, .35);}</style>\n</section>",
          "_cid": "wg0edRsczr",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-faq1-3k"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-notice1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-notice1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <select title=\"Style\" name=\"noticeStyle\">\n            <option value=\"note\">Note</option>\n            <option value=\"alert\" selected=\"\">Alert</option>\n            <option value=\"success\">Success</option>\n        </select>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-9\">\n                <div class=\"sk-alert\" role=\"note\" mbr-class=\"{'sk-alert--danger': noticeStyle == 'alert', 'sk-alert--success': noticeStyle == 'success'}\">\n                    <h4 class=\"sk-alert-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".sk-alert-title\">Important</h4>\n                    <p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Le non-respect du règlement peut entraîner une exclusion sans remboursement.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-alert{border-radius: var(--sk-r-md); padding: 1.25rem 1.5rem; background: var(--sk-ice-2); border-left: 6px solid var(--sk-sky);}.sk-alert--danger{background: rgba(227, 5, 19, .14); border-left-color: var(--sk-red);}.sk-alert--success{background: #dff3e7; border-left-color: #17703f;}.sk-alert .sk-alert-title{font-weight: 700; color: var(--sk-navy); margin-bottom: .25rem;}</style>\n</section>",
          "_cid": "gDKd8Jwdnv",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-notice1-3l"
        },
        {
          "alias": "skyline-blocks/components",
