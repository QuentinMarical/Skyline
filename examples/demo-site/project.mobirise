      "components": [
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {},
          "_name": "sk-menu1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-menu sk-menu1\" data-bs-version=\"5.1\" global=\"\" once=\"\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Button\" name=\"showButton\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Menu Items\" name=\"menuItems\" min=\"1\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-expand-lg container\" mbr-style=\"{'background-color': bgColor}\">\n        <a class=\"navbar-brand mbr-fonts-style\" mbr-theme-style=\"display-5\" href=\"index.html\" data-app-selector=\".navbar-brand\">Horizon</a>\n        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-nav\" aria-controls=\"sk-nav\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n            <span class=\"navbar-toggler-icon\"></span>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"sk-nav\">\n            <ul class=\"navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center\" mbr-list=\"\" mbr-list-grow=\"menuItems\">\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"index.html\">Accueil</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"about.html\">À propos</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"programme.html\">Programme</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"tickets.html\">Billets</a></li>\n                <li class=\"nav-item\" mbr-text=\"\"><a class=\"nav-link mbr-fonts-style\" mbr-theme-style=\"display-4\" href=\"faq.html\">FAQ</a></li>\n            </ul>\n            <div class=\"mbr-section-btn ms-lg-3\" mbr-if=\"showButton\" mbr-buttons=\"\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                <a class=\"sk-btn sk-btn-primary\" href=\"register.html\">S'inscrire</a>\n            </div>\n        </div>\n    </nav>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-btn{display: inline-flex; max-width: 100%; text-align: center; justify-content: center; align-items: center; gap: .5rem; padding: .75rem 1.5rem; border-radius: var(--sk-r-pill); border: 2px solid transparent; font-weight: 500; text-decoration: none; transition: transform .15s, background-color .15s;}.sk-btn:hover{transform: translateY(-1px);}.sk-btn.sk-btn-primary{background: var(--sk-navy); color: var(--sk-white);}.sk-btn.sk-btn-primary:hover{background: #0d0da0; color: var(--sk-white);}.sk-menu{position: sticky; top: 0; z-index: 1000; background: var(--sk-white); box-shadow: 0 1px 0 rgba(0,0,0,.06);}.sk-menu .navbar{min-height: 64px;}.sk-menu .nav-link{color: #444; font-weight: 500;}.sk-menu .nav-link:hover{color: var(--sk-navy);}.sk-menu .navbar-brand{font-family: var(--sk-font-title); color: var(--sk-navy); font-size: 1.5rem;}</style>\n</section>\n",
          "_cid": "vyjBviDVkq",
          "_protectedParams": [],
          "_global": true,
          "_once": true,
          "_params": {},
          "_anchor": "sk-menu1-38"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-text1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-text1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Signature\" name=\"showSignature\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-9 text-center\">\n                <h2 class=\"sk-title mbr-section-title mb-4 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Rejoignez le staff</h2>\n                <p class=\"mbr-text mb-4 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\">Le festival repose sur l'énergie de ses bénévoles. Découvrez les postes à pourvoir, puis remplissez le formulaire pour candidater.</p>\n                <p class=\"sk-signature mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSignature\" data-app-selector=\".sk-signature\">The team is waiting for you!</p>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-signature{font-weight: 700; color: var(--sk-navy);}</style>\n</section>",
          "_cid": "Hwwb9EqT2V",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "sk-text1-39"
        },
        {
          "alias": "skyline-blocks/components",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "sk-positions1",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"sk-block sk-positions1\" data-bs-version=\"5.1\" plugins=\"skyline\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"range\" inline title=\"Positions\" name=\"jobs\" min=\"1\" max=\"5\" step=\"1\" value=\"5\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center mb-5 text-center\">\n            <div class=\"col-12 col-lg-8\">\n                <h2 class=\"sk-title mbr-section-title mb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Postes à pourvoir</h2>\n                <h3 class=\"sk-subtitle mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Cliquez sur un intitulé pour afficher le détail.</h3>\n            </div>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-9\">\n                <div class=\"accordion sk-faq\" id=\"sk-jobs-acc\">\n                    <div class=\"accordion-item\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-1\" aria-expanded=\"true\" aria-controls=\"sk-job-1\">Sécurité <span class=\"sk-count ms-2\">(10)</span></button></h3>\n                        <div id=\"sk-job-1\" class=\"accordion-collapse collapse show\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Responsabilités clés</h4>\n                                <ul><li><strong>Avant :</strong> préparer et planifier.</li><li><strong>Pendant :</strong> animer l'activité sur place.</li><li><strong>Après :</strong> faire le bilan et transmettre.</li></ul>\n                                <h4 class=\"sk-sub\">Compétences et profil</h4>\n                                <ul><li><strong>Savoir-faire :</strong> expérience pertinente.</li><li><strong>Savoir-être :</strong> esprit d'équipe et fiabilité.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"jobs > 1\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-2\" aria-expanded=\"false\" aria-controls=\"sk-job-2\">Logistique <span class=\"sk-count ms-2\">(4)</span></button></h3>\n                        <div id=\"sk-job-2\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Responsabilités clés</h4>\n                                <ul><li><strong>Avant :</strong> préparer et planifier.</li><li><strong>Pendant :</strong> animer l'activité sur place.</li><li><strong>Après :</strong> faire le bilan et transmettre.</li></ul>\n                                <h4 class=\"sk-sub\">Compétences et profil</h4>\n                                <ul><li><strong>Savoir-faire :</strong> expérience pertinente.</li><li><strong>Savoir-être :</strong> esprit d'équipe et fiabilité.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"jobs > 2\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-3\" aria-expanded=\"false\" aria-controls=\"sk-job-3\">Opérations <span class=\"sk-count ms-2\">(5)</span></button></h3>\n                        <div id=\"sk-job-3\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Responsabilités clés</h4>\n                                <ul><li><strong>Avant :</strong> préparer et planifier.</li><li><strong>Pendant :</strong> animer l'activité sur place.</li><li><strong>Après :</strong> faire le bilan et transmettre.</li></ul>\n                                <h4 class=\"sk-sub\">Compétences et profil</h4>\n                                <ul><li><strong>Savoir-faire :</strong> expérience pertinente.</li><li><strong>Savoir-être :</strong> esprit d'équipe et fiabilité.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"jobs > 3\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-4\" aria-expanded=\"false\" aria-controls=\"sk-job-4\">Accueil et inscriptions <span class=\"sk-count ms-2\">(6)</span></button></h3>\n                        <div id=\"sk-job-4\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Responsabilités clés</h4>\n                                <ul><li><strong>Avant :</strong> préparer et planifier.</li><li><strong>Pendant :</strong> animer l'activité sur place.</li><li><strong>Après :</strong> faire le bilan et transmettre.</li></ul>\n                                <h4 class=\"sk-sub\">Compétences et profil</h4>\n                                <ul><li><strong>Savoir-faire :</strong> expérience pertinente.</li><li><strong>Savoir-être :</strong> esprit d'équipe et fiabilité.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"accordion-item\" mbr-if=\"jobs > 4\">\n                        <h3 class=\"accordion-header\"><button class=\"accordion-button collapsed mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#sk-job-5\" aria-expanded=\"false\" aria-controls=\"sk-job-5\">Technique <span class=\"sk-count ms-2\">(2)</span></button></h3>\n                        <div id=\"sk-job-5\" class=\"accordion-collapse collapse\" data-bs-parent=\"#sk-jobs-acc\">\n                            <div class=\"accordion-body mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <h4 class=\"sk-sub\">Responsabilités clés</h4>\n                                <ul><li><strong>Avant :</strong> préparer et planifier.</li><li><strong>Pendant :</strong> animer l'activité sur place.</li><li><strong>Après :</strong> faire le bilan et transmettre.</li></ul>\n                                <h4 class=\"sk-sub\">Compétences et profil</h4>\n                                <ul><li><strong>Savoir-faire :</strong> expérience pertinente.</li><li><strong>Savoir-être :</strong> esprit d'équipe et fiabilité.</li></ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <style>:root{--sk-navy: #080866; --sk-sky: #38bdf5; --sk-red: #e30512; --sk-ice: #b5cce8; --sk-ice-2: #dce7f5; --sk-ice-3: #f2f7fa; --sk-ink: #111; --sk-muted: #5c6370; --sk-white: #fff; --sk-r-sm: 10px; --sk-r-md: 14px; --sk-r-lg: 18px; --sk-r-pill: 64px; --sk-font-title: \"Shrikhand\", \"Inter\", sans-serif; --sk-font-body: \"Inter\", system-ui, sans-serif; --sk-shadow: 0 8px 24px rgba(8, 8, 102, .12);}.sk-block{font-family: var(--sk-font-body); color: var(--sk-ink); position: relative;}.sk-block .sk-title{font-family: var(--sk-font-title); color: var(--sk-navy); font-weight: 400; line-height: 1.05;}.sk-block .sk-subtitle{color: var(--sk-muted);}.sk-block :focus-visible{outline: 2px solid var(--sk-navy); outline-offset: 2px;}.sk-block .mbr-overlay{position: absolute; inset: 0; pointer-events: none;}.sk-block > .container,.sk-block > .container-fluid{position: relative; z-index: 1;}.sk-faq .accordion-item{border: 0; background: rgba(181, 204, 232, .17); border-radius: var(--sk-r-md) !important; margin-bottom: .75rem; overflow: hidden;}.sk-faq .accordion-button{background: transparent; font-weight: 700; color: var(--sk-navy); box-shadow: none;}.sk-faq .accordion-button:not(.collapsed){color: var(--sk-navy); background: rgba(181, 204, 232, .35);}.sk-positions1 .accordion-body .sk-sub{font-size: 1rem; font-weight: 700; color: var(--sk-navy); margin: 1rem 0 .5rem;}.sk-positions1 .accordion-body .sk-sub:first-child{margin-top: 0;}.sk-count{color: var(--sk-muted); font-weight: 400;}</style>\n</section>",
